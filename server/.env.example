PORT=5000
JWT_SECRET=your_jwt_secret_key_here
# Teacher Access Code (required for new teacher signup):
TEACHER_ACCESS_CODE=your_secure_access_code_here
APP_PASSWORD=your_secure_access_code_here
STUDENT_PASSWORD=your_student_password_here

# Gemini Configuration:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Configuration (optional alternative):
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration:
SUPABASE_URL=https://your-supabase-project.supabase.co
# Modern Supabase API Keys (New standard replacing legacy anon/service_role keys):
# Publishable key: safe for browser/client-side access with Row Level Security (RLS) enabled
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Secret key: privileged access for backend servers/workers/functions, bypasses RLS
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Legacy Supabase Keys (supported as fallback until retired by Supabase):
# SUPABASE_ANON_KEY=your_legacy_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here
