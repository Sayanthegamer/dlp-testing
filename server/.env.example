PORT=5000
JWT_SECRET=your_jwt_secret_key_here
# Teacher Access Code (required for new teacher signup):
TEACHER_ACCESS_CODE=your_secure_access_code_here
APP_PASSWORD=your_secure_access_code_here
STUDENT_PASSWORD=your_student_password_here

# Gemini Configuration:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Configuration (optional alternative):
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Database & Storage Configuration:
SUPABASE_URL=https://your-supabase-project.supabase.co
# Modern Supabase API Keys (From Supabase Dashboard -> Project Settings -> API Keys):
# Publishable key (sb_publishable_... — browser / client-safe with Row Level Security enabled):
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Secret / Hidden key (sb_secret_... — privileged server-side backend operations, bypasses RLS):
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Optional alias supported if your deployment names the secret key SUPABASE_HIDDEN_KEY:
# SUPABASE_HIDDEN_KEY=your_supabase_secret_key_here
